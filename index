            },
            {
                subject: 'Espanhol',
                question: 'Identifique a frase em espanhol com o particípio irregular grafado CORRETAMENTE:',
                options: [
                    'A) El libro fue escribido por un autor famoso.',
                    'B) He abierto la ventana esta mañana.',
                    'C) Juan ha ponido el abrigo en la silla.',
                    'D) La carta fue rompedora y vertida.'
                ],
                correct: 1,
                explanation: 'Opção B correta! O particípio de "abrir" é "abierto" (He abierto). Os particípios "escribido" e "ponido" são erros gravíssimos em espanhol (o correto é escrito e puesto).'
            }
        ];

        let currentQuizIndex = 0;
        let quizScore = 0;

        // Initialize App on Load
        window.addEventListener('DOMContentLoaded', () => {
            loadReviewedState();
            updateProgressBar();
        });

        // LocalStorage logic for reviewed sub-blocks
        function getReviewedState() {
            try {
                return JSON.parse(localStorage.getItem('edital26_reviewed')) || {};
            } catch (e) {
                return {};
            }
        }

        function loadReviewedState() {
            const state = getReviewedState();
            ALL_SUBBLOCK_IDS.forEach(id => {
                const checkbox = document.getElementById(`check-${id}`);
                if (checkbox) {
                    checkbox.checked = !!state[id];
                }
            });
        }

        function toggleReviewed(id) {
            const state = getReviewedState();
            state[id] = !state[id];
            localStorage.setItem('edital26_reviewed', JSON.stringify(state));
            loadReviewedState();
            updateProgressBar();
        }

        function updateProgressBar() {
            const state = getReviewedState();
            const reviewedCount = Object.keys(state).filter(k => state[k]).length;
            const percentage = Math.round((reviewedCount / TOTAL_SUBBLOCKS) * 100);

            const progressBar = document.getElementById('heroProgressBar');
            const progressText = document.getElementById('heroProgressText');

            if (progressBar && progressText) {
                progressBar.style.width = `${percentage}%`;
                progressText.textContent = `${reviewedCount}/${TOTAL_SUBBLOCKS} revisados (${percentage}%)`;
            }
        }

        // View Navigation Logic
        function navigateToSubject(subjectId) {
            const homeView = document.getElementById('homeView');
            const subjectView = document.getElementById('subjectDetailView');
            const subjectCards = document.querySelectorAll('.subject-card');

            if (!subjectId) return;

            homeView.classList.add('hidden');
            subjectView.classList.remove('hidden');

            subjectCards.forEach(card => {
                if (subjectId === 'all' || card.id === `subject-${subjectId}`) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });

            // Update header tag title
            const tag = document.getElementById('currentSubjectTitleTag');
            const titles = {
                'lingua': 'Análise Linguística',
                'lit': 'Literatura (Realismo)',
                'ing': 'Inglês Nível 2',
                'esp': 'Espanhol',
                'artes': 'Artes',
                'edfisica': 'Educação Física',
                'all': 'Todas as Disciplinas'
            };
            if (tag) tag.textContent = titles[subjectId] || 'Exibindo Matéria';

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function openAllSubjectsView() {
            navigateToSubject('all');
        }

        function backToHomeView() {
            document.getElementById('homeView').classList.remove('hidden');
            document.getElementById('subjectDetailView').classList.add('hidden');
            const navSelect = document.getElementById('subjectNavSelect');
            if (navSelect) navSelect.value = "";
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function navigateToSubBlock(subblockId) {
            const item = SEARCH_INDEX.find(x => x.id === subblockId);
            if (!item) return;

            navigateToSubject(item.subject);
            setTimeout(() => {
                const subEl = document.getElementById(`subblock-${subblockId}`);
                if (subEl) {
                    subEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    openSubBlock(subblockId);
                }
            }, 300);
        }

        // Accordion expand/collapse
        function toggleSubBlock(id) {
            const content = document.getElementById(`content-${id}`);
            const arrow = document.getElementById(`arrow-${id}`);
            
            if (content.classList.contains('open')) {
                content.classList.remove('open');
                if (arrow) arrow.style.transform = 'rotate(0deg)';
            } else {
                content.classList.add('open');
                if (arrow) arrow.style.transform = 'rotate(180deg)';
            }
        }

        function openSubBlock(id) {
            const content = document.getElementById(`content-${id}`);
            const arrow = document.getElementById(`arrow-${id}`);
            if (content && !content.classList.contains('open')) {
                content.classList.add('open');
                if (arrow) arrow.style.transform = 'rotate(180deg)';
            }
        }

        function toggleExpandAllSubBlocks(expand) {
            ALL_SUBBLOCK_IDS.forEach(id => {
                const content = document.getElementById(`content-${id}`);
                const arrow = document.getElementById(`arrow-${id}`);
                if (content) {
                    if (expand) {
                        content.classList.add('open');
                        if (arrow) arrow.style.transform = 'rotate(180deg)';
                    } else {
                        content.classList.remove('open');
                        if (arrow) arrow.style.transform = 'rotate(0deg)';
                    }
                }
            });
        }

        // Scroll Helper
        function scrollToSection(id) {
            backToHomeView();
            setTimeout(() => {
                const el = document.getElementById(id);
                if (el) el.scrollIntoView({ behavior: 'smooth' });
            }, 100);
        }

        // Search Engine Functionality
        function handleSearch(query) {
            const dropdown = document.getElementById('searchResultsDropdown');
            const cleanQuery = query.trim().toLowerCase();

            if (!cleanQuery) {
                dropdown.classList.add('hidden');
                return;
            }

            const matches = SEARCH_INDEX.filter(item => 
                item.title.toLowerCase().includes(cleanQuery) || 
                item.keywords.toLowerCase().includes(cleanQuery)
            );

            if (matches.length === 0) {
                dropdown.innerHTML = `
                    <div class="p-4 text-xs text-inkSecondary text-center font-mono-custom">
                        Nenhum tópico encontrado para "${query}".
                    </div>
                `;
            } else {
                dropdown.innerHTML = matches.map(m => `
                    <div onclick="navigateToSubBlock('${m.id}')" class="p-3 hover:bg-secondarySurface cursor-pointer flex items-center justify-between group">
                        <div>
                            <span class="text-[10px] font-mono-custom text-inkSecondary uppercase">${m.subject}</span>
                            <h5 class="text-xs font-semibold text-inkPrimary group-hover:text-inkPrimary">${m.title}</h5>
                        </div>
                        <span class="text-xs text-inkSecondary font-mono-custom group-hover:text-acid font-bold">Ir →</span>
                    </div>
                `).join('');
            }

            dropdown.classList.remove('hidden');
        }

        function triggerSearchJump() {
            const input = document.getElementById('heroSearchInput');
            if (input && input.value) {
                const cleanQuery = input.value.trim().toLowerCase();
                const match = SEARCH_INDEX.find(item => 
                    item.title.toLowerCase().includes(cleanQuery) || 
                    item.keywords.toLowerCase().includes(cleanQuery)
                );
                if (match) {
                    navigateToSubBlock(match.id);
                    document.getElementById('searchResultsDropdown').classList.add('hidden');
                }
            }
        }

        // Quiz Modal Logic
        function openQuizModal() {
            currentQuizIndex = 0;
            quizScore = 0;
            renderQuizQuestion();
            document.getElementById('quizModal').classList.remove('hidden');
        }

        function closeQuizModal() {
            document.getElementById('quizModal').classList.add('hidden');
        }

        function renderQuizQuestion() {
            const q = QUIZ_QUESTIONS[currentQuizIndex];
            const container = document.getElementById('quizQuestionContainer');
            const counter = document.getElementById('quizCounterText');
            const feedbackBox = document.getElementById('quizFeedbackBox');
            const nextBtn = document.getElementById('nextQuizBtn');

            counter.textContent = `Questão ${currentQuizIndex + 1} de ${QUIZ_QUESTIONS.length} • ${q.subject}`;
            feedbackBox.classList.add('hidden');
            nextBtn.classList.add('hidden');

            container.innerHTML = `
                <div class="space-y-3">
                    <p class="text-sm font-medium text-inkPrimary leading-relaxed">${q.question}</p>
                    <div class="space-y-2 pt-2">
                        ${q.options.map((opt, idx) => `
                            <button onclick="checkAnswer(${idx})" class="quiz-opt-btn w-full text-left p-3 rounded-xl border border-hairline hover:border-inkPrimary text-xs font-mono-custom text-inkPrimary hover:bg-secondarySurface transition-all flex items-center justify-between">
                                <span>${opt}</span>
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function checkAnswer(selectedIdx) {
            const q = QUIZ_QUESTIONS[currentQuizIndex];
            const optBtns = document.querySelectorAll('.quiz-opt-btn');
            const feedbackBox = document.getElementById('quizFeedbackBox');
            const nextBtn = document.getElementById('nextQuizBtn');

            optBtns.forEach((btn, idx) => {
                btn.disabled = true;
                if (idx === q.correct) {
                    btn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900', 'font-bold');
                } else if (idx === selectedIdx && selectedIdx !== q.correct) {
                    btn.classList.add('bg-red-100', 'border-red-400', 'text-red-900');
                }
            });

            if (selectedIdx === q.correct) {
                quizScore++;
                feedbackBox.className = "p-4 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-900 text-xs font-mono-custom leading-relaxed space-y-1";
                feedbackBox.innerHTML = `<strong>✔ CORRETO!</strong><p>${q.explanation}</p>`;
            } else {
                feedbackBox.className = "p-4 rounded-xl border border-red-300 bg-red-50 text-red-900 text-xs font-mono-custom leading-relaxed space-y-1";
                feedbackBox.innerHTML = `<strong>✖ INCORRETO.</strong><p>${q.explanation}</p>`;
            }

            feedbackBox.classList.remove('hidden');
            nextBtn.classList.remove('hidden');
        }

        function nextQuestion() {
            currentQuizIndex++;
            if (currentQuizIndex < QUIZ_QUESTIONS.length) {
                renderQuizQuestion();
            } else {
                // Quiz Finish State
                const container = document.getElementById('quizQuestionContainer');
                const counter = document.getElementById('quizCounterText');
                const feedbackBox = document.getElementById('quizFeedbackBox');
                const nextBtn = document.getElementById('nextQuizBtn');

                counter.textContent = "RESULTADO FINAL DO SIMULADO";
                feedbackBox.classList.add('hidden');
                nextBtn.classList.add('hidden');

                const percentage = Math.round((quizScore / QUIZ_QUESTIONS.length) * 100);

                container.innerHTML = `
                    <div class="text-center py-6 space-y-4 font-mono-custom">
                        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-acid text-inkPrimary text-3xl font-extrabold">
                            ${quizScore}/${QUIZ_QUESTIONS.length}
                        </div>
                        <h4 class="text-xl font-bold text-inkPrimary">Você concluiu o Simulado Relâmpago!</h4>
                        <p class="text-xs text-inkSecondary max-w-md mx-auto">
                            Sua taxa de acerto foi de <strong>${percentage}%</strong>. Continue revisando os sub-blocos e fixando os conceitos do edital!
                        </p>
                        <button onclick="openQuizModal()" class="px-6 py-3 rounded-full bg-inkPrimary text-acid text-xs font-bold hover:bg-inkPrimary/90 spring-transform inline-block">
                            Refazer Simulado ⚡
                        </button>
                    </div>
                `;
            }
        }
    </script>
